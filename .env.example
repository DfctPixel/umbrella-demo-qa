# Umbrella Demo QA - Environment Configuration
# Copy this file to .env and fill in your credentials
# DO NOT commit .env to version control!

BASE_URL=https://dev.umbrellacost.dev
API_URL=https://api.dev.umbrellacost.dev/api/v1
USER_EMAIL=your-email@example.com
USER_PASSWORD=your-password

# Tenant capability fallback (used when plain-sub-users returns no accounts[0]).
# The live profile value is always preferred when available.
# Replace the placeholders below with your assigned QA tenant values.
QA_ACCOUNT_KEY=111111177
QA_ACCOUNT_TYPE_ID=0
QA_DIVISION_ID=0
QA_CURRENCY=USD
